{
  "name": "@vex/ui",
  "version": "0.35.0",
  "private": true,
  "type": "module",
  "description": "Shared design for *.vexoul.net: tokens, Vue components and the design lab",
  "repository": "github:vexouLuna/vex-ui",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/styles/fonts.css",
    "src/styles/platform.css",
    "src/fonts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./account": {
      "types": "./dist/types/account.d.ts",
      "import": "./dist/account.js"
    },
    "./utils": {
      "types": "./dist/types/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./style.css": "./dist/style.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./platform.css": "./src/styles/platform.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "story:dev": "histoire dev",
    "story:build": "histoire build",
    "prepare": "npm run build",
    "changeset": "changeset",
    "release": "changeset version"
  },
  "peerDependencies": {
    "vue": "^3.5.44"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@histoire/plugin-vue": "^1.0.0-beta.1",
    "@vex/platform-web": "github:vexouLuna/vex-platform-web#v0.14.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "histoire": "^1.0.0-beta.1",
    "noisejs": "^2.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=22"
  }
}
