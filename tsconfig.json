{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "jsx": "preserve",
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],
    "paths": { "@vex/ui": ["./src/index.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "stories/**/*.ts", "stories/**/*.vue", "tests/**/*.ts", "vite.config.ts", "histoire.config.ts"]
}
